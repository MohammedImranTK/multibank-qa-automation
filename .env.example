# Base URL under test. The primary target (trade.multibank.io) sits behind a
# login wall for all routes, so the assessment's documented fallback is used
# by default. Override locally if needed.
BASE_URL=https://mb.io/en-AE

# Playwright trace/video capture mode: on | off | on-first-retry | retain-on-failure
TRACE_MODE=retain-on-failure

# Default per-action timeout (ms)
ACTION_TIMEOUT=15000

# Default navigation timeout (ms)
NAVIGATION_TIMEOUT=30000
